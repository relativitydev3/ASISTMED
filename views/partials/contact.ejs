<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="contact__container container">

    <div class="section-heading">
      <p class="section-eyebrow">Contacto</p>
      <h2 class="section-title" id="contact-title">Hablemos sobre el cuidado que necesitas</h2>
      <p class="section-text section-text--center"><%= contacto.descripcion %></p>
    </div>

    <div class="contact__grid">

      <form class="contact-form" id="contactForm" data-animate="slide-right" novalidate>
        <div class="contact-form__group">
          <label for="name" class="contact-form__label">Nombre completo</label>
          <input
            type="text"
            id="name"
            name="name"
            class="contact-form__input"
            placeholder="Escribe tu nombre"
            required
            aria-required="true"
          >
        </div>

        <div class="contact-form__group">
          <label for="email" class="contact-form__label">Correo electrónico</label>
          <input
            type="email"
            id="email"
            name="email"
            class="contact-form__input"
            placeholder="tucorreo@ejemplo.com"
            required
            aria-required="true"
          >
        </div>

        <div class="contact-form__group">
          <label for="phone" class="contact-form__label">Teléfono</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            class="contact-form__input"
            placeholder="300 000 0000"
            required
            aria-required="true"
          >
        </div>

        <div class="contact-form__group">
          <label for="message" class="contact-form__label">Mensaje</label>
          <textarea
            id="message"
            name="message"
            class="contact-form__textarea"
            rows="4"
            placeholder="Cuéntanos qué necesitas"
            required
            aria-required="true"
          ></textarea>
        </div>

        <button type="submit" class="btn btn--primary btn--lg contact-form__submit">
          Enviar mensaje
        </button>

        <p class="contact-form__status" role="status" aria-live="polite" data-form-status></p>
      </form>

      <div class="contact-info" data-animate="slide-left">
        <div class="contact-info__map">
          <iframe
            src="<%= contacto.mapaEmbedUrl %>"
            title="Ubicación de <%= empresa.nombre %>"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>

        <ul class="contact-info__list">
          <li class="contact-info__item">
            <svg viewBox="0 0 24 24" class="contact-info__icon" aria-hidden="true" focusable="false">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <a href="tel:<%= empresa.telefono %>"><%= empresa.telefonoDisplay %></a>
          </li>
          <li class="contact-info__item">
            <svg viewBox="0 0 24 24" class="contact-info__icon" aria-hidden="true" focusable="false">
              <path d="M4 4h16v16H4z" fill="none" stroke="none"/>
              <path d="M22 6 12 13 2 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M2 6h20v12H2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <a href="mailto:<%= empresa.correo %>"><%= empresa.correo %></a>
          </li>
          <li class="contact-info__item">
            <svg viewBox="0 0 24 24" class="contact-info__icon" aria-hidden="true" focusable="false">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="10" r="3" fill="none" stroke="currentColor" stroke-width="2"/>
            </svg>
            <span><%= empresa.direccion %></span>
          </li>
        </ul>
      </div>
    </div>

  </div>
</section>
