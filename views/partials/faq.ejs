<section class="faq" id="faq" aria-labelledby="faq-title">
  <div class="faq__container container">

    <div class="section-heading">
      <p class="section-eyebrow">Preguntas Frecuentes</p>
      <h2 class="section-title" id="faq-title">Resolvemos tus dudas</h2>
    </div>

    <div class="faq__accordion">
      <% faq.forEach(function(item, index){ %>
        <div class="faq-item" data-animate="fade-up" data-delay="<%= (index % 4) * 60 %>">
          <h3 class="faq-item__heading">
            <button
              class="faq-item__trigger"
              id="faq-trigger-<%= index %>"
              aria-expanded="false"
              aria-controls="faq-panel-<%= index %>"
              data-faq-trigger
            >
              <span><%= item.pregunta %></span>
              <svg viewBox="0 0 24 24" class="faq-item__icon" aria-hidden="true" focusable="false">
                <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </h3>
          <div
            class="faq-item__panel"
            id="faq-panel-<%= index %>"
            role="region"
            aria-labelledby="faq-trigger-<%= index %>"
            data-faq-panel
          >
            <p class="faq-item__answer"><%= item.respuesta %></p>
          </div>
        </div>
      <% }) %>
    </div>

  </div>
</section>
