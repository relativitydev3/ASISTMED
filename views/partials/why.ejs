<section class="why" id="why" aria-labelledby="why-title">
  <div class="why__container container">

    <div class="section-heading">
      <p class="section-eyebrow">Por Qué Elegirnos</p>
      <h2 class="section-title" id="why-title">La confianza de cientos de familias</h2>
    </div>

    <div class="why__grid">
      <% porQueElegirnos.forEach(function(item, index){ %>
        <article class="why-card" data-animate="fade-up" data-delay="<%= (index % 4) * 100 %>">
          <div class="why-card__icon" aria-hidden="true"><%- item.icono %></div>
          <div class="why-card__content">
            <h3 class="why-card__title"><%= item.titulo %></h3>
            <p class="why-card__text"><%= item.descripcion %></p>
          </div>
        </article>
      <% }) %>
    </div>

  </div>
</section>
