<section class="coverage" id="coverage" aria-labelledby="coverage-title">
  <div class="coverage__container container">

    <div class="coverage__content" data-animate="slide-right">
      <p class="section-eyebrow">Cobertura</p>
      <h2 class="section-title" id="coverage-title">Estamos presentes en todo el Valle de Aburrá</h2>
      <p class="section-text"><%= cobertura.descripcion %></p>

      <ul class="coverage__list" role="list">
        <% cobertura.municipios.forEach(function(municipio){ %>
          <li class="coverage__item">
            <svg viewBox="0 0 24 24" class="coverage__item-icon" aria-hidden="true" focusable="false">
              <path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <%= municipio %>
          </li>
        <% }) %>
      </ul>
    </div>

    <div class="coverage__media" data-animate="fade-in">
      <img
        src="<%= cobertura.mapaImagen %>"
        alt="Mapa ilustrativo de la cobertura de <%= empresa.nombre %> en el Valle de Aburrá"
        class="coverage__map"
        loading="lazy"
        width="600"
        height="600"
      >
    </div>

  </div>
</section>
