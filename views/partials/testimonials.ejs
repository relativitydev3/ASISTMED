<section class="testimonials" id="testimonials" aria-labelledby="testimonials-title">
  <div class="testimonials__container container">

    <div class="section-heading">
      <p class="section-eyebrow">Testimonios</p>
      <h2 class="section-title" id="testimonials-title">Lo que dicen las familias que confían en nosotros</h2>
    </div>

    <div class="testimonials__slider" data-testimonial-slider aria-roledescription="carrusel" aria-label="Testimonios de clientes">
      <div class="testimonials__track" data-testimonial-track>
        <% testimonios.forEach(function(testimonio, index){ %>
          <article class="testimonial-card" data-testimonial-slide aria-hidden="<%= index === 0 ? 'false' : 'true' %>">
            <div class="testimonial-card__stars" aria-label="<%= testimonio.estrellas %> de 5 estrellas">
              <% for(let i = 0; i < 5; i++){ %>
                <svg viewBox="0 0 24 24" class="testimonial-card__star <%= i < testimonio.estrellas ? 'is-filled' : '' %>" aria-hidden="true" focusable="false">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              <% } %>
            </div>
            <p class="testimonial-card__text">“<%= testimonio.comentario %>”</p>
            <div class="testimonial-card__author">
              <img
                src="<%= testimonio.foto %>"
                alt="Foto de <%= testimonio.nombre %>"
                class="testimonial-card__photo"
                loading="lazy"
                width="56"
                height="56"
              >
              <div>
                <span class="testimonial-card__name"><%= testimonio.nombre %></span>
                <span class="testimonial-card__role"><%= testimonio.rol %></span>
              </div>
            </div>
          </article>
        <% }) %>
      </div>

      <div class="testimonials__dots" data-testimonial-dots role="tablist" aria-label="Seleccionar testimonio">
        <% testimonios.forEach(function(_, index){ %>
          <button
            class="testimonials__dot <%= index === 0 ? 'is-active' : '' %>"
            role="tab"
            aria-selected="<%= index === 0 ? 'true' : 'false' %>"
            aria-label="Ir al testimonio <%= index + 1 %>"
            data-testimonial-dot="<%= index %>"
          ></button>
        <% }) %>
      </div>
    </div>

  </div>
</section>
