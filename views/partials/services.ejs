<section class="services" id="services" aria-labelledby="services-title">
  <div class="services__container container">

    <div class="section-heading">
      <p class="section-eyebrow">Nuestros Servicios</p>
      <h2 class="section-title" id="services-title">Atención profesional, en la comodidad de tu hogar</h2>
      <p class="section-text section-text--center">
        Un equipo médico y asistencial capacitado para acompañarte a ti y a tu familia con
        seguridad, calidez y excelencia clínica.
      </p>
    </div>

    <div class="services__grid">
      <% servicios.forEach(function(servicio, index){ %>
        <article class="service-card" data-animate="fade-up" data-delay="<%= (index % 3) * 100 %>">

          <div class="service-card__media">
            <img
              src="<%= servicio.imagen %>"
              alt="<%= servicio.imagenAlt || servicio.titulo %>"
              class="service-card__image"
              loading="lazy"
              width="400"
              height="260"
            >
          </div>

          <div class="service-card__body">
            <h3 class="service-card__title"><%= servicio.titulo %></h3>
            <p class="service-card__text"><%= servicio.descripcion %></p>
            <a
              href="<%= servicio.link || ('#service-' + servicio.slug) %>"
              class="service-card__link"
              aria-label="Ver más sobre <%= servicio.titulo %>"
            >
              Ver más
              <svg viewBox="0 0 24 24" class="service-card__link-icon" aria-hidden="true" focusable="false">
                <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </article>
      <% }) %>
    </div>

  </div>
</section>
