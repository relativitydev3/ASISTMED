<footer class="footer" role="contentinfo">
  <div class="footer__container container">

    <div class="footer__col footer__col--brand">
      <img src="<%= empresa.logoBlanco || empresa.logo %>" alt="Logotipo de <%= empresa.nombre %>" class="footer__logo" width="150" height="40">
      <p class="footer__tagline"><%= empresa.eslogan %></p>

      <div class="footer__socials">
        <a href="<%= empresa.facebook %>" class="footer__social" aria-label="Facebook de <%= empresa.nombre %>" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
        </a>
        <a href="<%= empresa.instagram %>" class="footer__social" aria-label="Instagram de <%= empresa.nombre %>" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2c2.72 0 3.06.01 4.12.06 1.06.05 1.79.22 2.43.47a4.9 4.9 0 0 1 1.77 1.15 4.9 4.9 0 0 1 1.15 1.77c.25.64.42 1.37.47 2.43.05 1.06.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.06-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.15 1.77 4.9 4.9 0 0 1-1.77 1.15c-.64.25-1.37.42-2.43.47-1.06.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.06-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.25-.64-.42-1.37-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.06.22-1.79.47-2.43a4.9 4.9 0 0 1 1.15-1.77A4.9 4.9 0 0 1 5.45.53C6.09.28 6.82.11 7.88.06 8.94.01 9.28 0 12 0Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm5.2-8.4a1.17 1.17 0 1 1-2.34 0 1.17 1.17 0 0 1 2.34 0Z"/></svg>
        </a>
        <a href="<%= empresa.whatsappLink %>" class="footer__social" aria-label="WhatsApp de <%= empresa.nombre %>" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.87.5 3.63 1.44 5.16L2 22l5.09-1.53a9.87 9.87 0 0 0 4.95 1.33h.01c5.46 0 9.9-4.45 9.9-9.9C21.95 6.45 17.5 2 12.04 2Z"/></svg>
        </a>
      </div>
    </div>

    <nav class="footer__col" aria-label="Enlaces del footer">
      <h3 class="footer__title">Navegación</h3>
      <ul class="footer__list">
        <li><a href="#about">Quiénes Somos</a></li>
        <li><a href="#services">Servicios</a></li>
        <li><a href="#why">Por Qué Elegirnos</a></li>
        <li><a href="#testimonials">Testimonios</a></li>
        <li><a href="#faq">Preguntas Frecuentes</a></li>
        <li><a href="#contact">Contacto</a></li>
      </ul>
    </nav>

    <div class="footer__col">
      <h3 class="footer__title">Cobertura</h3>
      <ul class="footer__list footer__list--coverage">
        <% cobertura.municipios.forEach(function(municipio){ %>
          <li><%= municipio %></li>
        <% }) %>
      </ul>
    </div>

    <div class="footer__col">
      <h3 class="footer__title">Contáctanos</h3>
      <ul class="footer__list">
        <li><a href="tel:<%= empresa.telefono %>"><%= empresa.telefonoDisplay %></a></li>
        <li><a href="mailto:<%= empresa.correo %>"><%= empresa.correo %></a></li>
        <li><a href="<%= empresa.whatsappLink %>" target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a></li>
      </ul>
    </div>

  </div>

  <div class="footer__bottom">
    <p>&copy; <%= new Date().getFullYear() %> <%= empresa.nombre %>. Todos los derechos reservados.</p>
  </div>
</footer>
