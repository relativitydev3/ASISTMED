<header class="navbar" id="navbar" role="banner">
  <div class="navbar__container container">

    <a href="#hero" class="navbar__logo" aria-label="<%= empresa.nombre %> - Inicio">
      <img src="<%= empresa.logo %>" alt="Logotipo de <%= empresa.nombre %>" width="150" height="40" class="navbar__logo-img">
    </a>

    <button
      class="navbar__toggle"
      id="navToggle"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="navMenu"
    >
      <span class="navbar__toggle-bar"></span>
      <span class="navbar__toggle-bar"></span>
      <span class="navbar__toggle-bar"></span>
    </button>

    <nav class="navbar__menu" id="navMenu" aria-label="Navegación principal">
      <ul class="navbar__list">
        <li><a href="#about" class="navbar__link">Quiénes Somos</a></li>
        <li><a href="#services" class="navbar__link">Servicios</a></li>
        <li><a href="#why" class="navbar__link">Por Qué Elegirnos</a></li>
        <li><a href="#coverage" class="navbar__link">Cobertura</a></li>
        <li><a href="#testimonials" class="navbar__link">Testimonios</a></li>
        <li><a href="#faq" class="navbar__link">Preguntas</a></li>
        <li><a href="#contact" class="navbar__link">Contacto</a></li>
      </ul>

      <a
        href="<%= empresa.whatsappLink %>"
        class="btn btn--whatsapp navbar__cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.87.5 3.63 1.44 5.16L2 22l5.09-1.53a9.87 9.87 0 0 0 4.95 1.33h.01c5.46 0 9.9-4.45 9.9-9.9C21.95 6.45 17.5 2 12.04 2Z"/>
        </svg>
        WhatsApp
      </a>
    </nav>
  </div>
</header>
