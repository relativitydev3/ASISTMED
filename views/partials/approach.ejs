<section class="approach" id="approach" aria-labelledby="approach-title">
  <div class="approach__container container">

    <div class="section-heading">
      <p class="section-eyebrow">Nuestro Enfoque</p>
      <h2 class="section-title" id="approach-title">Un cuidado centrado en la persona</h2>
    </div>

    <div class="approach__grid">
      <% enfoque.forEach(function(item, index){ %>
        <article class="approach-card" data-animate="fade-up" data-delay="<%= (index % 4) * 100 %>">
          <div class="approach-card__icon" aria-hidden="true"><%- item.icono %></div>
          <h3 class="approach-card__title"><%= item.titulo %></h3>
          <p class="approach-card__text"><%= item.descripcion %></p>
        </article>
      <% }) %>
    </div>

  </div>
</section>
